# Database: local file for dev, Turso URL for production
DATABASE_URL=file:./footkf.db
DATABASE_AUTH_TOKEN=
# Football-Data.org free key (server-side only)
FOOTBALL_DATA_API_KEY=
# Admin auth: scrypt not required; set a long random password and session secret
ADMIN_PASSWORD=
SESSION_SECRET=
# Shared secret for the scheduled sync endpoint (GitHub Actions cron)
CRON_SECRET=
